/*  ========================================================
 *  ==  WARNING: This is an automatically generated std::cout, ==
 *  ==                  do not modify.                    ==
 *  ========================================================
 */

% if disable_cse:
#define DISABLE_CSE
% endif

#include <iostream>
#include <fstream>
#include <olb.h>

using namespace olb;

using T = ${precision};
using TARGET_DYNAMICS = ${dynamics}; 


int main() {
    auto _id = meta::id<TARGET_DYNAMICS>();

    using DESCRIPTOR = decltype(_id)::type::descriptor_t;

    auto _dynamics = DynamicsPromise<T, DESCRIPTOR>(_id);

    auto opCount    = _dynamics.getArithmeticOperationCount();
    auto bandwidth  = _dynamics.getMemoryBandwidth();
    auto complexity = _dynamics.getComplexity();
    auto name       = _dynamics.name();
    auto isOptimized= _dynamics.hasOptimizedVersion();

    std::cout << "{" << std::endl;
    std::cout << "  \"name\": \""        << name        << "\"," << std::endl;
    std::cout << "  \"isOptimized\": "   << isOptimized << "," << std::endl; 
    std::cout << "  \"precision\": \"" << "${precision}" << "\"," << std::endl;
    std::cout << "  \"bandwidth\": "     << *bandwidth  << "," << std::endl;
    std::cout << "  \"complexity\": "    << *complexity << "," << std::endl;
    std::cout << "  \"FLOP\": "          << *opCount    << std::endl;
    std::cout << "}" << std::endl;

    return 0;
}
