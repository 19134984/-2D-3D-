#!/bin/bash
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare

cd $PBS_O_WORKDIR

NNODES=$(wc -l < $PBS_NODEFILE)
NRANKS_PER_NODE=12
NTOTRANKS=$(( NNODES * NRANKS_PER_NODE ))

export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:.
export MPIR_CVAR_ENABLE_GPU=1
export OMP_NUM_THREADS=1
export CPU_BIND_SCHEME="--cpu-bind=list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100"

RESOLUTIONS=($(python3 -c "
bases = [1, 2, 3]
node_sequence = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512]
current_nnodes = ${NNODES}
ranks_per_node = ${NRANKS_PER_NODE}
res_pool = set()

for b in bases:
    res_pool.add(int(round((b * 1e9)**(1/3.0))))

for n in node_sequence:
    if n <= current_nnodes:
        for b in bases:
            res_pool.add(int(round((b * n * 1e9)**(1/3.0))))

for r in sorted(res_pool):
    if (r**3) / (current_nnodes * ranks_per_node) >= 3e6:
        print(r)
"))

echo "Nodes: ${NNODES} | Total Ranks: ${NTOTRANKS} | Resolutions: ${RESOLUTIONS[@]}"

for RES in "${RESOLUTIONS[@]}"; do
    mpiexec -n ${NTOTRANKS} -ppn ${NRANKS_PER_NODE} ${CPU_BIND_SCHEME} \
    gpu_tile_compact.sh ./cavity3d --RESOLUTION ${RES} --TIME_STEPS 1000 --VTK_ENABLED 0
done

pkill -u $USER -P $$
exit 0
