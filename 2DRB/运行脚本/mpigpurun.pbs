#!/bin/bash
#PBS -N P100_3D_MPI_ACC
#PBS -q batch
#PBS -l nodes=node05:ppn=1+node07:ppn=1
#PBS -l walltime=240:00:00
#PBS -j oe

# 进入 qsub 提交时所在的目录。当前代码所有输出都是相对路径，
# 所以 SimulationSettings、snapshot、plt、reload 文件都会写到这个目录。
cd "$PBS_O_WORKDIR" || exit 1

ulimit -s unlimited

# NVHPC 24.3：compilers/bin 提供 nvfortran，comm_libs/mpi/bin 提供配套 MPI。
# 这里把 NVHPC MPI 放在 PATH 最前面，避免误用 master 默认的 Intel MPI。
export NVHPC_ROOT=/opt/nvidia/hpc_sdk/Linux_x86_64/24.3
export PATH="$NVHPC_ROOT/comm_libs/mpi/bin:$NVHPC_ROOT/compilers/bin:$PATH"
export LD_LIBRARY_PATH="$NVHPC_ROOT/comm_libs/mpi/lib:$NVHPC_ROOT/compilers/lib:$LD_LIBRARY_PATH"

# 每个节点只有 1 张 P100，当前代码是一 GPU 一 rank。
export CUDA_VISIBLE_DEVICES=0

echo "Job starts at $(date)"
echo "PWD = $PWD"
echo "PATH = $PATH"
echo "LD_LIBRARY_PATH = $LD_LIBRARY_PATH"
echo "Using mpirun: $(which mpirun)"
mpirun --version

# PBS_NODEFILE 由调度器给出；每行通常对应一个 slot。
# 这里去重后得到 node05/node07，和代码中的 NodeCount=2、GPUS_PER_NODE=1 对应。
if [ -n "$PBS_NODEFILE" ] && [ -f "$PBS_NODEFILE" ]; then
    sort -u "$PBS_NODEFILE" > hostfile.p100
else
    cat > hostfile.p100 << EOF
node05
node07
EOF
fi

echo "hostfile.p100:"
cat hostfile.p100

echo "GPU visibility check:"
mpirun -np 2 --hostfile hostfile.p100 --map-by ppr:1:node --bind-to none \
    -x CUDA_VISIBLE_DEVICES \
    -x PATH \
    -x LD_LIBRARY_PATH \
    bash -lc 'echo HOST=$(hostname) CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES; nvidia-smi --query-gpu=name,memory.total --format=csv,noheader'

echo "Run solver:"
mpirun -np 2 --hostfile hostfile.p100 --map-by ppr:1:node --bind-to none \
    -x CUDA_VISIBLE_DEVICES \
    -x PATH \
    -x LD_LIBRARY_PATH \
    ./a.out

echo "Job ends at $(date)"
