#!/bin/bash
#PBS -N RB_DIAG20
#PBS -q batch
#PBS -l nodes=node07:ppn=1
#PBS -l walltime=02:00:00
#PBS -o /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/pbs.stdout
#PBS -e /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/pbs.stderr
set -uo pipefail
test "$(hostname -s)" = node07 || exit 90
pids=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader,nounits) || exit 91
if [ -n "$pids" ]; then echo GPU_occupied;exit 75;fi
echo START Ra8_replay; date -Is
bash /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/Ra8_replay/run.sh
echo EXIT_Ra8_replay=$?; date -Is
echo START Ra6_seed; date -Is
bash /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/Ra6_seed/run.sh
echo EXIT_Ra6_seed=$?; date -Is
