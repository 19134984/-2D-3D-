#!/bin/bash
#PBS -N RB_BULK20
#PBS -q batch
#PBS -l nodes=node07:ppn=1
#PBS -l walltime=02:00:00
#PBS -o /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/bulk_pbs.stdout
#PBS -e /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/bulk_pbs.stderr
set -uo pipefail
test "$(hostname -s)" = node07 || exit 90
pids=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader,nounits) || exit 91
if [ -n "$pids" ]; then echo GPU_occupied;exit 75;fi
echo START Ra8_coarse_scaled
bash /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/Ra8_coarse_scaled/run.sh
echo EXIT=$?
echo START Ra8_coarse_magic
bash /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/Ra8_coarse_magic/run.sh
echo EXIT=$?
echo START Ra8_magic_from_zero
bash /data2/XLLi/Multiblock/data2D/RB/diagnosis_20261020/Ra8_magic_from_zero/run.sh
echo EXIT=$?
