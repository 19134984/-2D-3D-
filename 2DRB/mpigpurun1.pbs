#!/bin/bash
#PBS -N P100_2D_MPI_ACC_1GPU
#PBS -q batch
#PBS -l nodes=node05:ppn=1
#PBS -l walltime=240:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1

ulimit -s unlimited

# NVHPC 24.3: put the matching NVHPC MPI before the system MPI.
export NVHPC_ROOT=/opt/nvidia/hpc_sdk/Linux_x86_64/24.3
export PATH="$NVHPC_ROOT/comm_libs/mpi/bin:$NVHPC_ROOT/compilers/bin:$PATH"
export LD_LIBRARY_PATH="$NVHPC_ROOT/comm_libs/mpi/lib:$NVHPC_ROOT/compilers/lib:$LD_LIBRARY_PATH"

# One P100 per node; this baseline uses one MPI rank on one visible GPU.
# Source must be built with NodeCount=1 and GPUS_PER_NODE=1.
export CUDA_VISIBLE_DEVICES=0

echo "Job starts at $(date)"
echo "PWD = $PWD"
echo "PATH = $PATH"
echo "LD_LIBRARY_PATH = $LD_LIBRARY_PATH"
echo "Using mpirun: $(which mpirun)"
mpirun --version

if [ -n "$PBS_NODEFILE" ] && [ -f "$PBS_NODEFILE" ]; then
    sort -u "$PBS_NODEFILE" > hostfile.p100
else
    cat > hostfile.p100 << EOF
node05
EOF
fi

echo "hostfile.p100:"
cat hostfile.p100

echo "GPU visibility check:"
mpirun -np 1 --hostfile hostfile.p100 --map-by ppr:1:node --bind-to none \
    -x CUDA_VISIBLE_DEVICES \
    -x PATH \
    -x LD_LIBRARY_PATH \
    bash -lc 'echo HOST=$(hostname) CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES; nvidia-smi --query-gpu=name,memory.total --format=csv,noheader'

echo "Run solver:"
mpirun -np 1 --hostfile hostfile.p100 --map-by ppr:1:node --bind-to none \
    -x CUDA_VISIBLE_DEVICES \
    -x PATH \
    -x LD_LIBRARY_PATH \
    ./a.out

echo "Job ends at $(date)"
